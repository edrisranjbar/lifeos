# Docker Compose settings. Copy to .env and change every value.
# Your Edi Life OS sign-in (you can change it later in Settings).
LIFEOS_USERNAME=me
LIFEOS_PASSWORD=change-me-to-a-long-password

# MySQL passwords used only inside the Docker network.
LIFEOS_DB_PASSWORD=change-me-db-password
LIFEOS_DB_ROOT_PASSWORD=change-me-root-password

# Optional: enable the HTTP API and MCP server with a long random token
# (php -r "echo bin2hex(random_bytes(32));"). Leave empty to disable the API.
LIFEOS_API_TOKEN=

# Set to true only when a TLS-terminating reverse proxy sits in front of the app.
# It makes the app trust X-Forwarded-Proto (Secure cookies) and X-Forwarded-For
# (login rate limiting per client).
LIFEOS_TRUST_PROXY=false

# Host port for the web app.
LIFEOS_PORT=8080
